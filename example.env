# Скопируйте этот файл в `.env` в корне проекта:
#   cp example.env .env
#
# После изменения `.env` перезапустите Metro
# (Ctrl+C → npx expo start / npx expo run:android).
#
# Префикс EXPO_PUBLIC_ обязателен: Expo подставляет такие
# переменные в клиентский бандл на этапе сборки.

# ---------------------------------------------------------------------------
# URL бэкенд-сервера (корень API, без /api/auth в конце)
# ---------------------------------------------------------------------------
# Auth  →  {EXPO_PUBLIC_API_URL}/api/auth
# REST  →  {EXPO_PUBLIC_API_URL}/products  и т.п.
#
# Варианты:
#   Android-эмулятор → http://10.0.2.2:4000
#     (10.0.2.2 = localhost вашего компьютера с точки зрения эмулятора)
#   iOS-симулятор    → http://localhost:4000
#   Реальный телефон → http://192.168.x.x:4000
#     (IP компьютера в той же Wi‑Fi сети; порт — как у вашего API)
#   Прод / staging   → https://api.example.com
#
# Для phone-standalone release APK (`npm run release:apk`):
#   - НЕ используйте 10.0.2.2 / localhost / 127.0.0.1 (скрипт отклонит их)
#   - задайте LAN IP или прод-URL через окружение, или скопируйте этот файл в
#     `.env.release` и укажите там EXPO_PUBLIC_API_URL для телефона
#   - пример: EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
#
# Бэкенд с Better Auth должен быть запущен отдельно и слушать этот хост/порт.
# На сервере настройте trustedOrigins для схемы приложения (trekkingfoodv2://).

EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
